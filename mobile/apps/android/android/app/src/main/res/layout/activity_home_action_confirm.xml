<?xml version="1.0" encoding="utf-8"?>
<!-- #244: Bestaetigungsfenster des Szenen/Routinen-Widgets ("X starten?" Ja/Nein). Tipp daneben = Nein. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_confirm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#47000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/idea_card_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/home_confirm_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textColor="@color/donna_heading"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_confirm_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/widget_home_confirm_hint"
            android:textColor="@color/donna_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/home_confirm_no"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/widget_home_no"
                android:textAllCaps="false"
                android:textColor="@color/donna_accent" />

            <Button
                android:id="@+id/home_confirm_yes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/idea_button_bg"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/widget_home_yes"
                android:textAllCaps="false"
                android:textColor="@color/donna_on_accent_solid" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
