<?xml version="1.0" encoding="utf-8"?>
<!-- #244: Szenen/Routinen-Widget. Bis zu 2 Zeilen x 3 Knoepfe; ein Tipp oeffnet NUR das Bestaetigungsfenster. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/home_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/home_b0" style="@style/DonnaWidgetHomeButton" />
        <TextView android:id="@+id/home_b1" style="@style/DonnaWidgetHomeButton" />
        <TextView android:id="@+id/home_b2" style="@style/DonnaWidgetHomeButton" />

        <ImageView
            android:id="@+id/home_edit"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_home_edit"
            android:padding="6dp"
            android:src="@drawable/ic_donna_settings"
            android:tint="@color/donna_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView android:id="@+id/home_b3" style="@style/DonnaWidgetHomeButton" />
        <TextView android:id="@+id/home_b4" style="@style/DonnaWidgetHomeButton" />
        <TextView android:id="@+id/home_b5" style="@style/DonnaWidgetHomeButton" />
    </LinearLayout>

    <TextView
        android:id="@+id/home_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="40dp"
        android:text="@string/widget_home_setup"
        android:textColor="@color/donna_text"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
