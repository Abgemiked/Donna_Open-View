<?xml version="1.0" encoding="utf-8"?>
<!-- #244: Auswahl der Knoepfe (Szenen/Routinen). Hier wird nichts ausgeloest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/donna_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/widget_home_config_title"
        android:textColor="@color/donna_heading"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_config_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/donna_muted"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/home_config_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/home_config_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/idea_cancel"
            android:textAllCaps="false"
            android:textColor="@color/donna_accent" />

        <Button
            android:id="@+id/home_config_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/idea_button_bg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/idea_save"
            android:textAllCaps="false"
            android:textColor="@color/donna_on_accent_solid" />
    </LinearLayout>
</LinearLayout>
