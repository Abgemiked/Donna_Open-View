<?xml version="1.0" encoding="utf-8"?>
<!-- #240: ein Termin — Zeit + Titel; ganze Zeile tippbar (oeffnet den Termin). Hoehe = WidgetFormat.ROW_DP. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:minWidth="44dp"
        android:textColor="@color/donna_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/donna_text"
        android:textSize="14sp" />

    <!-- #243: wer hat erstellt / wer ist beteiligt („Mike“, „Ämi“, „Mike + Ämi“) -->
    <TextView
        android:id="@+id/widget_row_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_tag_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="88dp"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:textColor="@color/donna_on_accent_container"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
