# DONNA-219: Keystore-Properties — Kopieren nach keystore.properties und befüllen
# keystore.properties ist in .gitignore und wird NIEMALS committed!
#
# Alternativ können Umgebungsvariablen verwendet werden:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
#
# Pfad relativ zu android/app/ — z.B. donna-release.keystore liegt in android/app/
storeFile=donna-release.keystore
storePassword=DEIN_KEYSTORE_PASSWORT
keyAlias=donna
keyPassword=DEIN_KEY_PASSWORT
